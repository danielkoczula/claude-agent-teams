{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wlc/portfolio-grid",
  "version": "1.0.0",
  "title": "WLC Portfolio Grid",
  "category": "widgets",
  "description": "Siatka portfolio z filtrowaniem i paginacją.",
  "textdomain": "wlc-blocks",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
  "render": "file:./render.php",
  "viewScriptModule": "file:./view.js",
  "attributes": {
    "postsPerPage": {
      "type": "number",
      "default": 9
    },
    "showCategoryFilter": {
      "type": "boolean",
      "default": true
    },
    "showTechnologyFilter": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "html": false,
    "align": [ "wide", "full" ],
    "color": {
      "background": false,
      "text": false
    },
    "interactivity": {
      "clientNavigation": true
    }
  }
}
