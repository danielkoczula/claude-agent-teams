{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"features": {
		"networking": true
	},
	"steps": [
		{
			"step": "login",
			"username": "admin",
			"password": "admin"
		},
		{
			"step": "installPlugin",
			"pluginZipFile": {
				"resource": "wordpress.org/plugins",
				"slug": "gutenberg"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "setSiteOptions",
			"options": {
				"blogname": "WLC Blocks Dev",
				"blogdescription": "WordPress dev environment for WLC blocks"
			}
		},
		{
            "step": "mkdir",
            "path": "/wordpress/wp-content/themes/wlc-theme/templates"
        },
        {
            "step": "writeFile",
            "path": "/wordpress/wp-content/themes/wlc-theme/style.css",
            "data": "/*\nTheme Name: WLC Theme\nType: block\n*/"
        },
        {
            "step": "writeFile",
            "path": "/wordpress/wp-content/themes/wlc-theme/templates/index.html",
            "data": "<div class=\"wp-block-group\"></div>"
        },
        {
            "step": "activateTheme",
            "themeFolderName": "wlc-theme"
        }
	]
}
