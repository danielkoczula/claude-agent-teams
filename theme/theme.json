{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"palette": [
				{ "slug": "brand-primary", "color": "#e3002f", "name": "Brand Primary" },
				{ "slug": "brand-dark", "color": "#1a1a1a", "name": "Brand Dark" },
				{ "slug": "text-main", "color": "#000000", "name": "Text Main" },
				{ "slug": "text-muted", "color": "#666666", "name": "Text Muted" },
				{ "slug": "bg-base", "color": "#ffffff", "name": "BG Base" },
				{ "slug": "bg-card-alt", "color": "#f4f4f4", "name": "BG Card Alt" },
				{ "slug": "border-card", "color": "#e8e8e8", "name": "Border Card" },
				{ "slug": "tag-tech", "color": "#4ee2c0", "name": "Tag Tech" },
				{ "slug": "tag-category", "color": "#f5e52e", "name": "Tag Category" }
			]
		},
		"spacing": {
			"spacingSizes": [
				{ "slug": "xs", "size": "0.5rem", "name": "XS" },
				{ "slug": "sm", "size": "1rem", "name": "SM" },
				{ "slug": "md", "size": "1.5rem", "name": "MD" },
				{ "slug": "xl", "size": "3rem", "name": "XL" }
			],
			"units": [ "px", "em", "rem", "vh", "vw", "%" ]
		},
		"typography": {
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "primary",
					"name": "Primary",
					"fontFamily": "Montserrat, sans-serif",
					"fontFace": [
						{ "fontFamily": "Montserrat", "fontWeight": "400", "fontStyle": "normal", "src": [ "https://fonts.gstatic.com/s/montserrat/v26/JTUHjIg1_i6t8kCHKm4532VJOt5-QNFgpCtr6Hw5aXo.woff2" ] },
						{ "fontFamily": "Montserrat", "fontWeight": "600", "fontStyle": "normal", "src": [ "https://fonts.gstatic.com/s/montserrat/v26/JTUHjIg1_i6t8kCHKm4532VJOt5-QNFgpCu173w5aXo.woff2" ] },
						{ "fontFamily": "Montserrat", "fontWeight": "700", "fontStyle": "normal", "src": [ "https://fonts.gstatic.com/s/montserrat/v26/JTUHjIg1_i6t8kCHKm4532VJOt5-QNFgpCuM73w5aXo.woff2" ] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "tag", "size": "0.625rem", "name": "Tag" },
				{ "slug": "link", "size": "0.75rem", "name": "Link" },
				{ "slug": "body", "size": "0.8125rem", "name": "Body" },
				{ "slug": "pagination", "size": "0.875rem", "name": "Pagination" },
				{ "slug": "h3", "size": "1.0625rem", "name": "H3" },
				{ "slug": "icon", "size": "1.25rem", "name": "Icon" },
				{ "slug": "h2", "size": "3rem", "name": "H2" }
			]
		},
		"layout": {
			"contentSize": "1200px",
			"wideSize": "1440px"
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--primary)",
			"fontSize": "var(--wp--preset--font-size--body)",
			"lineHeight": "1.5"
		},
		"color": {
			"background": "var(--wp--preset--color--bg-base)",
			"text": "var(--wp--preset--color--text-main)"
		}
	}
}
